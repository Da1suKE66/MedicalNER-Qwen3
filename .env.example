# DeepSeek API (required for targeted repair and full semantic audit)
# The full audit sends each record's source text and graph to this third-party API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Strict JSON repair is most reliable with thinking disabled. Enable it only
# when the selected provider/model returns response_format JSON consistently.
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
# 32768 is needed for full per-entity/per-relation audit responses on large records.
DEEPSEEK_MAX_TOKENS=32768
DEEPSEEK_TIMEOUT_SECONDS=120
# Deterministic structured auditing; keep at 0 unless intentionally changing the run.
DEEPSEEK_TEMPERATURE=0
# Set true only when the local machine must use HTTP(S)_PROXY to reach DeepSeek.
DEEPSEEK_TRUST_ENV_PROXY=false

# Optional legacy generator compatibility; leave empty when using DeepSeek.
GEMINI_API_KEY=

# WHO ICD-11 API (required for ICD code/title validation)
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=
WHO_ICD_BASE_URL=https://id.who.int
WHO_ICD_TOKEN_URL=https://icdaccessmanagement.who.int/connect/token
WHO_ICD_API_VERSION=v2
WHO_ICD_RELEASE=2025-01
WHO_ICD_LANGUAGE=en

# Project paths
KG_DATA_PATH=data/raw/mental_disorders_20251125_165535.json
KG_OUTPUT_ROOT=outputs
# On the remote training hosts, override this with a path under /cache/liluchen.
KG_CACHE_ROOT=.cache
ICD_API_CACHE_DIR=${KG_CACHE_ROOT}/icd-api/2025-01/en
DEEPSEEK_REPAIR_CACHE_DIR=${KG_CACHE_ROOT}/deepseek-repair

# Training defaults
BASE_MODEL=Qwen/Qwen3-8B
SPECIFIC_ADAPTER=models/adapters/qwen3-8b-cot-specific
STANDARD_ADAPTER=models/adapters/qwen3-8b-cot-standard
